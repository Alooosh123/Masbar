# --- Backend ---
ENVIRONMENT=development
# Development may use "*"; production must list exact trusted browser origins.
CORS_ORIGINS=http://localhost:8080
MIN_VISUAL_CONFIDENCE=0.85
DEMO_MODE=true

# Manual excerpts may be licensed. Keep disabled unless the runtime is local/private.
MANUAL_SEARCH_ENABLED=false

# Vision provider: mock | openai | cohere | openrouter
# OpenRouter default model: nvidia/nemotron-3.5-super-vl:free
# Leave VISION_MODEL empty to use the provider default.
VISION_PROVIDER=mock
VISION_MODEL=
VISION_TIMEOUT_SECONDS=60

# OpenAI-compatible vision API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenRouter API (NVIDIA Nemotron 3.5 Super VL free vision model; server-side key only)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Cohere Chat v2 provider (native API with JSON-schema structured outputs)
COHERE_API_KEY=
COHERE_BASE_URL=https://api.cohere.com/v2

# General conversation + Arabic neural TTS
CHAT_PROVIDER=cohere
CHAT_MODEL=command-a-plus-05-2026
CHAT_TIMEOUT_SECONDS=45
TTS_PROVIDER=edge
TTS_VOICE=ar-SA-ZariyahNeural
TTS_TIMEOUT_SECONDS=25

# Sessions
SESSION_TTL_MINUTES=240\nSESSION_DB_PATH=data/sessions/sessions.sqlite3

# --- Web ---
# Backend port used by scripts and the web client (8000 is often taken by Mizan).
# If you change this, also set VITE_API_URL accordingly for the web app.
API_PORT=8010
# Leave empty to auto-detect http://<current-host>:8010
VITE_API_URL=
